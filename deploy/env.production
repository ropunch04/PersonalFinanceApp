# Production .env — copy to /home/rohitpras/PersonalFinanceApp/.env on the Pi
# Generate SECRET_KEY with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX

DEBUG=false
DB_PATH=data/finance.db

# Generate ENCRYPTION_KEY with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# Set to your Cloudflare Tunnel public URL (no trailing slash)
ALLOWED_ORIGIN=https://finance.yourdomain.com

RUN_SCHEDULER=false
REGISTRATION_ENABLED=false
LOG_FILE=logs/app.log
