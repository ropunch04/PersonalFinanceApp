[Unit]
Description=Cloudflare Tunnel (trackmyspend.xyz)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=rohitpras
# Tunnel name must match: cloudflared tunnel create finance-app
# Config lives at /home/rohitpras/.cloudflared/config.yml (see deploy/cloudflared-config.yml)
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate --config /home/rohitpras/.cloudflared/config.yml run finance-app

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cloudflared

# Hardening
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
