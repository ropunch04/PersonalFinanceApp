[Unit]
Description=Cloudflare Tunnel (budget.kotero.dev)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=kyleotero
# Tunnel name must match: cloudflared tunnel create budget
# Config lives at /home/kyleotero/.cloudflared/config.yml (see deploy/cloudflared-config.yml)
ExecStart=/home/kyleotero/.local/bin/cloudflared tunnel --no-autoupdate --config /home/kyleotero/.cloudflared/config.yml run budget

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cloudflared

# Hardening
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
