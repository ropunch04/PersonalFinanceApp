[Unit]
Description=Personal Finance App (Gunicorn)
After=network.target
Wants=network.target

[Service]
Type=notify
NotifyAccess=main

User=kyleotero
WorkingDirectory=/home/kyleotero/projects/PersonalFinanceApp

EnvironmentFile=/home/kyleotero/projects/PersonalFinanceApp/.env
ExecStart=/home/kyleotero/projects/PersonalFinanceApp/venv/bin/gunicorn \
    --config gunicorn.conf.py \
    app:app

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=finance-app

# Hardening
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/home/kyleotero/projects/PersonalFinanceApp/data
ReadWritePaths=/home/kyleotero/projects/PersonalFinanceApp/logs

[Install]
WantedBy=multi-user.target
