[Unit]
Description=Personal Finance App (Gunicorn)
After=network.target
Wants=network.target

[Service]
Type=notify
NotifyAccess=main

User=rohitpras
WorkingDirectory=/home/rohitpras/PersonalFinanceApp

EnvironmentFile=/home/rohitpras/PersonalFinanceApp/.env
ExecStart=/home/rohitpras/PersonalFinanceApp/venv/bin/gunicorn \
    --config gunicorn.conf.py \
    app:app

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=finance-app

# Hardening: OS is read-only to the service; only data/ and logs/ are writable
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/home/rohitpras/PersonalFinanceApp/data
ReadWritePaths=/home/rohitpras/PersonalFinanceApp/logs

[Install]
WantedBy=multi-user.target
